# Configure these privately in the backend hosting environment.
NODE_ENV=production
DB_HOST=YOUR_HOSTING_MYSQL_HOSTNAME
DB_USER=YOUR_HOSTING_MYSQL_USERNAME
DB_PASSWORD=YOUR_HOSTING_MYSQL_PASSWORD
DB_NAME=u183109547_Zgv47
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Relative to backend/server.js; requires the sibling resources folder.
PROFILE_PICTURES_DIR=../resources

# Use your mailbox provider's outgoing SMTP settings, not MySQL credentials.
SMTP_HOST=YOUR_MAIL_PROVIDER_SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_SENDING_MAILBOX_ADDRESS
SMTP_PASSWORD=YOUR_MAILBOX_PASSWORD_OR_APP_PASSWORD
SMTP_FROM=YOUR_SENDING_MAILBOX_ADDRESS
APP_LOGIN_URL=https://learndev.site/login
